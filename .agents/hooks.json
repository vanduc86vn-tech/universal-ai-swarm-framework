{
  "runtime-file-firewall": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "stop-oracle-and-ssot-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/stop_verification_gate.py",
        "timeout": 30
      }
    ]
  }
}
