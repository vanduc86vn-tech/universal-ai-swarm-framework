{
  "pre-invocation-role-anchor": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/pre_invocation_anchor.js",
        "timeout": 5
      }
    ]
  },
  "runtime-physical-firewall": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|run_command|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/pre_tool_firewall.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "stop-duty-completion-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/stop_completion_gate.js",
        "timeout": 15
      }
    ]
  }
}
